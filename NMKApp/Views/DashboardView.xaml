<UserControl x:Class="NMKApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NMKApp.Converters">

    <UserControl.Resources>
        <converters:TaskStatusToColorConverter         x:Key="StatusColorConv"/>
        <converters:TaskStatusToTextConverter          x:Key="StatusTextConv"/>
        <converters:BoolToVisibilityConverter          x:Key="BoolVisConv"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StrVisConv"/>
        <converters:StringToBrushConverter             x:Key="StrBrushConv"/>
        <converters:BindingProxy                       x:Key="DataProxy" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== LOADING OVERLAY ===== -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Panel.ZIndex="99"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVisConv}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="Loading..." HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- ===== FILTER BAR ===== -->
        <Border Grid.Row="0" Background="White" Padding="12,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.10"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- AssignedByMe / AssignedToMe tab group -->
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="AssignedByMe" GroupName="AssignMode"
                                     IsChecked="{Binding IsAssignedByMe}"
                                     Style="{StaticResource TabToggleStyle}"
                                     Command="{Binding ToggleAssignedByMeCommand}"/>
                        <RadioButton Content="AssignedToMe" GroupName="AssignMode"
                                     Style="{StaticResource TabToggleStyle}"
                                     Command="{Binding ToggleAssignedToMeCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Today checkbox -->
                <CheckBox Content="Today" IsChecked="{Binding IsToday}"
                          VerticalAlignment="Center" Margin="12,0" FontSize="13"/>

                <!-- Status filter dropdown (ToggleButton + Popup) -->
                <Grid Margin="4,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="StatusDropBtn" MinWidth="150" Padding="10,7" FontSize="13"
                                  VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusFilterText}" VerticalAlignment="Center"/>
                            <TextBlock Text=" ▾" VerticalAlignment="Center" Opacity="0.6" Margin="4,0,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=StatusDropBtn, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=StatusDropBtn}"
                           Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="White"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" MinWidth="180">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding Data.StatusFilterItems, Source={StaticResource DataProxy}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="2,5" FontSize="13"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Project filter ComboBox -->
                <ComboBox ItemsSource="{Binding Projects}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedProjectFilter}"
                          Width="165" Margin="4,0" Padding="8,6" FontSize="13"
                          VerticalAlignment="Center"/>

                <!-- Month / Year -->
                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Month" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,2"/>
                        <TextBox Text="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}"
                                 Width="44" Padding="6,4" FontSize="13" TextAlignment="Center"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Year" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,2"/>
                        <TextBox Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}"
                                 Width="58" Padding="6,4" FontSize="13" TextAlignment="Center"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- New Task button -->
                <Button Content="＋ New Task" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.NewTaskVM.ShowCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Border>

        <!-- ===== MAIN CONTENT: horizontal-scrolling project columns ===== -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ProjectCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One column per project: fixed Width, fills full height -->
                        <Grid Width="280" Margin="8,8,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ── PROJECT CARD ── -->
                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="0,0,0,2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.12"/>
                                </Border.Effect>
                                <!-- Inner border clips avatar image to rounded corners -->
                                <Border CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <StackPanel>
                                        <!-- Avatar / Logo area -->
                                        <Grid Height="155" Background="#37474F">
                                            <!-- Default diamond logo (hidden when avatar set) -->
                                            <Viewbox Width="96" Height="96" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Avatar,
                                                         Converter={StaticResource StrVisConv},
                                                         ConverterParameter=Invert}">
                                                <Canvas Width="100" Height="100">
                                                    <Polygon Points="50,8 92,33 92,67 50,92 8,67 8,33"
                                                             Fill="#546E7A" Stroke="#78909C" StrokeThickness="1"/>
                                                    <Polygon Points="50,8 92,33 50,54 8,33" Fill="#E53935"/>
                                                    <Polygon Points="8,33 50,54 50,92 8,67"  Fill="#BDBDBD"/>
                                                    <Polygon Points="92,33 50,54 50,92 92,67" Fill="#9E9E9E"/>
                                                </Canvas>
                                            </Viewbox>
                                            <!-- Avatar image (shown when Avatar is set) -->
                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                   Visibility="{Binding Avatar, Converter={StaticResource StrVisConv}}"/>
                                            <!-- Admin: change avatar overlay button -->
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="6" Padding="6,3" FontSize="11"
                                                    Content="📷 Avatar"
                                                    Visibility="{Binding DataContext.IsAdmin,
                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                        Converter={StaticResource BoolVisConv}}"
                                                    Command="{Binding DataContext.ChangeProjectAvatarCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#AA000000"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bdr"
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bdr" Property="Background"
                                                                                    Value="#CC1976D2"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- Project info strip (project color background) -->
                                        <Border Padding="12,10"
                                                Background="{Binding Color, Converter={StaticResource StrBrushConv}}"
                                                CornerRadius="0,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="Name : " FontWeight="Bold"
                                                           Foreground="White" FontSize="12"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Foreground="White" FontSize="12"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="CreateAt : " FontWeight="Bold"
                                                           Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding CreatedAt}"
                                                           Foreground="White" FontSize="12" Margin="0,2,0,0"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0"
                                                           Text="Version : " FontWeight="Bold"
                                                           Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Text="{Binding RevitVersion}"
                                                           Foreground="White" FontSize="12" Margin="0,2,0,0"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0"
                                                           Text="Description : " FontWeight="Bold"
                                                           Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1"
                                                           Text="{Binding Description}"
                                                           Foreground="White" FontSize="12" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>

                            <!-- ── TASK LIST (vertical scroll within column) ── -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,2,4,0">
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.10"/>
                                                </Border.Effect>
                                                <Border CornerRadius="8" Padding="10,8"
                                                        Background="{Binding Status,
                                                            Converter={StaticResource StatusColorConv}}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Status label + Task name + Action buttons -->
                                                        <DockPanel Grid.Row="0">
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Top"
                                                                        Margin="6,0,0,0">
                                                                <Button Style="{StaticResource IconButtonStyle}"
                                                                        ToolTip="Accept"
                                                                        Command="{Binding DataContext.AcceptTaskCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding Id}">
                                                                    <TextBlock Text="&#xE73E;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="13"/>
                                                                </Button>
                                                                <Button Style="{StaticResource IconButtonStyle}"
                                                                        Margin="4,0,0,0" ToolTip="Start"
                                                                        Command="{Binding DataContext.StartTaskCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding Id}">
                                                                    <TextBlock Text="&#xE768;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="13"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- StatusText : TaskName (wrapping) -->
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       VerticalAlignment="Top"
                                                                       Foreground="White"
                                                                       TextWrapping="Wrap">
                                                                <Run Text="{Binding StatusText, Mode=OneWay}"
                                                                     FontWeight="Bold" FontSize="12"/>
                                                                <Run Text=" : " FontSize="12"/>
                                                                <Run Text="{Binding Name, Mode=OneWay}"
                                                                     FontSize="13"/>
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <!-- Row 1: Start / End -->
                                                        <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                                            <TextBlock Foreground="White" FontSize="11">
                                                                <Run Text="Start : " FontWeight="Bold"/>
                                                                <Run Text="{Binding StartText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Foreground="White" FontSize="11"
                                                                       Margin="10,0,0,0">
                                                                <Run Text="End : " FontWeight="Bold"/>
                                                                <Run Text="{Binding EndText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </WrapPanel>

                                                        <!-- Row 2: AssignedBy -->
                                                        <TextBlock Grid.Row="2" Foreground="White"
                                                                   FontSize="11" Margin="0,4,0,0">
                                                            <Run Text="AssignedBy : " FontWeight="Bold"/>
                                                            <Run Text="{Binding AssignerEmail, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
