<UserControl x:Class="NMKApp.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" Padding="16,12">
            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
            <TextBlock Text="Users" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" Margin="16"
                  Style="{StaticResource ModernDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="200" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Email" Width="250" Binding="{Binding Email}"/>
                <DataGridTextColumn Header="Team" Width="150" Binding="{Binding Team}"/>
                <DataGridTextColumn Header="Role" Width="120" Binding="{Binding UserRole}"/>
                <DataGridTextColumn Header="Location" Width="*" Binding="{Binding Location}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
