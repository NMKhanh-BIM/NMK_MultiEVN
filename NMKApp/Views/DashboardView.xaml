<UserControl x:Class="NMKApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NMKApp.ViewModels"
             xmlns:converters="clr-namespace:NMKApp.Converters">

    <UserControl.Resources>
        <converters:TaskStatusToColorConverter x:Key="StatusColorConv"/>
        <converters:TaskStatusToTextConverter x:Key="StatusTextConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVisConv"/>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Border Background="#80FFFFFF" Panel.ZIndex="10"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVisConv}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="Loading..." HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0">
                <!-- Filter Bar -->
                <Border Background="White" Padding="16,10" Margin="0,0,0,1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08"/>
                    </Border.Effect>
                    <WrapPanel VerticalAlignment="Center">
                        <!-- AssignedByMe / AssignedToMe tabs -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <RadioButton Content="AssignedByMe" GroupName="AssignMode"
                                         IsChecked="{Binding IsAssignedByMe}"
                                         Style="{StaticResource TabToggleStyle}"
                                         Command="{Binding ToggleAssignedByMeCommand}"/>
                            <RadioButton Content="AssignedToMe" GroupName="AssignMode"
                                         Style="{StaticResource TabToggleStyle}" Margin="4,0,0,0"
                                         Command="{Binding ToggleAssignedToMeCommand}"/>
                        </StackPanel>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>

                        <!-- Today toggle -->
                        <CheckBox Content="Today" IsChecked="{Binding IsToday}" 
                                  VerticalAlignment="Center" Margin="8,0" FontSize="13"
                                  Command="{Binding ToggleTodayCommand}"/>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>

                        <!-- Status filter -->
                        <ComboBox ItemsSource="{Binding StatusFilters}" Width="140"
                                  SelectedIndex="0" Margin="8,0" Padding="8,6" FontSize="13"/>

                        <!-- Project filter -->
                        <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectedValue="{Binding SelectedProjectFilter}"
                                  Width="160" Margin="8,0" Padding="8,6" FontSize="13"/>

                        <!-- Month / Year -->
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <TextBlock Text="Month" VerticalAlignment="Center" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding SelectedMonth, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="40" Padding="6,4" FontSize="13" TextAlignment="Center"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                            <TextBlock Text="Year" VerticalAlignment="Center" Margin="8,0,4,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="56" Padding="6,4" FontSize="13" TextAlignment="Center"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>

                        <!-- New Task Button -->
                        <Button Content="＋ New Task" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="16,0,0,0"
                                Command="{Binding DataContext.NewTaskVM.ShowCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </WrapPanel>
                </Border>

                <!-- Project Cards -->
                <ItemsControl ItemsSource="{Binding ProjectCards}" Margin="16,16,16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Width="300" Margin="0,0,16,16">
                                <StackPanel>
                                    <!-- Project Logo Area -->
                                    <Border Background="#37474F" Height="180" CornerRadius="8,8,0,0">
                                        <Grid>
                                            <!-- Revit-style logo -->
                                            <Viewbox Width="120" Height="120">
                                                <Canvas Width="100" Height="100">
                                                    <Polygon Points="50,10 90,35 90,65 50,90 10,65 10,35" 
                                                             Fill="#546E7A" Stroke="#78909C" StrokeThickness="1"/>
                                                    <Polygon Points="50,10 90,35 50,55 10,35" Fill="#E53935"/>
                                                    <Polygon Points="10,35 50,55 50,90 10,65" Fill="#BDBDBD"/>
                                                    <Polygon Points="90,35 50,55 50,90 90,65" Fill="#9E9E9E"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <!-- Project Info -->
                                    <Border Background="#F57C00" Padding="12,10" CornerRadius="0,0,8,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name : "
                                                       FontWeight="Bold" Foreground="White" FontSize="12"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CreateAt : "
                                                       FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedAt}"
                                                       Foreground="White" FontSize="12" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Version : "
                                                       FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RevitVersion}"
                                                       Foreground="White" FontSize="12" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description : "
                                                       FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Description}"
                                                       Foreground="White" FontSize="12" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Task Cards -->
                <ItemsControl ItemsSource="{Binding TaskCards}" Margin="16,0,16,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340" Margin="0,0,16,12" CornerRadius="10"
                                    Padding="0" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.12"/>
                                </Border.Effect>
                                <Border CornerRadius="10" Padding="14,10"
                                        Background="{Binding Status, Converter={StaticResource StatusColorConv}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Status + Name + Buttons -->
                                        <DockPanel Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.AcceptTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" ToolTip="Accept">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.StartTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" ToolTip="Start">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <Run Text="{Binding StatusText, Mode=OneWay}" FontWeight="Bold" FontSize="13"/>
                                                <Run Text=" : " FontSize="13"/>
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                            </TextBlock>
                                        </DockPanel>

                                        <!-- Dates -->
                                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                            <TextBlock Foreground="White" FontSize="12">
                                                <Run Text="Start : " FontWeight="Bold"/>
                                                <Run Text="{Binding StartText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="White" FontSize="12" Margin="20,0,0,0">
                                                <Run Text="End : " FontWeight="Bold"/>
                                                <Run Text="{Binding EndText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </WrapPanel>

                                        <!-- Assignee -->
                                        <TextBlock Grid.Row="2" Foreground="White" FontSize="12" Margin="0,4,0,0">
                                            <Run Text="AssignedTo : " FontWeight="Bold"/>
                                            <Run Text="{Binding AssigneeEmail, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
