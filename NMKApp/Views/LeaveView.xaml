<UserControl x:Class="NMKApp.Views.LeaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NMKApp.Converters">

    <UserControl.Resources>
        <converters:LeaveStatusToColorConverter x:Key="LeaveStatusColorConv"/>
        <converters:LeaveStatusToTextConverter x:Key="LeaveStatusTextConv"/>
        <converters:LeaveTypeToTextConverter x:Key="LeaveTypeTextConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVisConv"/>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Border Background="#80FFFFFF" Panel.ZIndex="10"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVisConv}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" VerticalAlignment="Center"/>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="White" Padding="16,10" Grid.Row="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08"/>
                </Border.Effect>
                <DockPanel>
                    <Button Content="＋ New Leave Request" Style="{StaticResource PrimaryButtonStyle}"
                            DockPanel.Dock="Right" Command="{Binding ShowCreateLeaveCommand}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="My Requests" GroupName="LeaveMode"
                                     IsChecked="{Binding IsMyRequests}"
                                     Style="{StaticResource TabToggleStyle}"
                                     Command="{Binding ToggleMyRequestsCommand}"/>
                        <RadioButton Content="Pending Approvals" GroupName="LeaveMode"
                                     Style="{StaticResource TabToggleStyle}" Margin="4,0,0,0"
                                     Command="{Binding TogglePendingApprovalsCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">
                <!-- Leave List -->
                <DataGrid ItemsSource="{Binding LeaveItems}" 
                          Style="{StaticResource ModernDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                          Margin="16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Width="120"
                                            Binding="{Binding LeaveType, Converter={StaticResource LeaveTypeTextConv}}"/>
                        <DataGridTextColumn Header="Status" Width="100"
                                            Binding="{Binding Status, Converter={StaticResource LeaveStatusTextConv}}"/>
                        <DataGridTextColumn Header="From" Width="120"
                                            Binding="{Binding DateFrom, Converter={StaticResource DateConv}, ConverterParameter=dd/MM/yyyy}"/>
                        <DataGridTextColumn Header="To" Width="120"
                                            Binding="{Binding DateTo, Converter={StaticResource DateConv}, ConverterParameter=dd/MM/yyyy}"/>
                        <DataGridTextColumn Header="Days" Width="60" Binding="{Binding TotalDays}"/>
                        <DataGridTextColumn Header="Requester" Width="200" Binding="{Binding RequesterEmail}"/>
                        <DataGridTextColumn Header="Approver" Width="200" Binding="{Binding ApproverEmail}"/>
                        <DataGridTextColumn Header="Reason" Width="*" Binding="{Binding Reason}"/>
                        <DataGridTemplateColumn Header="Actions" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Approve" Style="{StaticResource SuccessButtonStyle}"
                                                Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                                Command="{Binding DataContext.ApproveLeaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Id}"
                                                Visibility="{Binding DataContext.IsMyRequests, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolVisConv}, ConverterParameter=Invert}"/>
                                        <Button Content="Reject" Style="{StaticResource DangerButtonStyle}"
                                                Padding="10,4" FontSize="11"
                                                Command="{Binding DataContext.RejectLeaveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Id}"
                                                Visibility="{Binding DataContext.IsMyRequests, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolVisConv}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- New Leave Dialog -->
                <Border Background="#80000000" Panel.ZIndex="5"
                        Visibility="{Binding IsCreatingLeave, Converter={StaticResource BoolVisConv}}">
                    <Border Background="White" CornerRadius="12" Width="480" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="New Leave Request" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                            <!-- Leave Type -->
                            <TextBlock Text="Leave Type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding LeaveTypes}" DisplayMemberPath="Value"
                                      SelectedValuePath="Key" SelectedValue="{Binding NewLeaveType}"
                                      Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                            <!-- Project -->
                            <TextBlock Text="Project (optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                                      SelectedValuePath="Id" SelectedValue="{Binding SelectedProjectId}"
                                      Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                            <!-- Approver -->
                            <TextBlock Text="Approver" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Approvers}" DisplayMemberPath="Email"
                                      SelectedValuePath="Id" SelectedValue="{Binding SelectedApproverId}"
                                      Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                            <!-- Dates -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="From" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding NewDateFrom}" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="To" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <DatePicker SelectedDate="{Binding NewDateTo}" FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <!-- Half Day -->
                            <CheckBox Content="Half Day" IsChecked="{Binding NewIsHalfDay}" 
                                      FontSize="13" Margin="0,0,0,12"/>

                            <!-- Reason -->
                            <TextBlock Text="Reason" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewReason}" Style="{StaticResource ModernTextBoxStyle}"
                                     Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Padding="16,8" FontSize="13"
                                        Background="#E0E0E0" Foreground="#424242"
                                        Command="{Binding CancelCreateLeaveCommand}" Margin="0,0,8,0"
                                        Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" 
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Submit" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SubmitLeaveCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
