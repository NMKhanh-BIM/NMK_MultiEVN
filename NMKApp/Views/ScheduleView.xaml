<UserControl x:Class="NMKApp.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NMKApp.Converters">
    <UserControl.Resources>
        <converters:DateFormatConverter x:Key="DateConv"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" Padding="16,12">
            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Schedule" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,20,0"/>
                <TextBlock Text="Month" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                <TextBox Text="{Binding SelectedMonth}" Width="40" Padding="6,4" Style="{StaticResource ModernTextBoxStyle}"/>
                <TextBlock Text="Year" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding SelectedYear}" Width="56" Padding="6,4" Style="{StaticResource ModernTextBoxStyle}"/>
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Attendances}" Margin="16"
                  Style="{StaticResource ModernDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="120" Binding="{Binding WorkDate, StringFormat=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="Status" Width="120" Binding="{Binding AttendanceStatus}"/>
                <DataGridTextColumn Header="Check In" Width="140" Binding="{Binding CheckInAt, Converter={StaticResource DateConv}}"/>
                <DataGridTextColumn Header="Check Out" Width="140" Binding="{Binding CheckOutAt, Converter={StaticResource DateConv}}"/>
                <DataGridTextColumn Header="Work Minutes" Width="120" Binding="{Binding WorkMinutes}"/>
                <DataGridTextColumn Header="Note" Width="*" Binding="{Binding Note}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
