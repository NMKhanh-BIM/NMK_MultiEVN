<UserControl x:Class="NMKApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" Padding="16,12">
            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <Border Grid.Row="1" Margin="16" Background="White" CornerRadius="8" Padding="24">
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12"/></Border.Effect>
            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                <TextBlock Text="Supabase Configuration" FontSize="16" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                
                <TextBlock Text="Supabase URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SupabaseUrl}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>
                
                <TextBlock Text="Supabase API Key" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SupabaseKey}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,20"/>
                
                <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
