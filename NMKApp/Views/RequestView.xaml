<UserControl x:Class="NMKApp.Views.RequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NMKApp.Converters">
    <UserControl.Resources>
        <converters:LeaveTypeToTextConverter x:Key="LeaveTypeConv"/>
        <converters:DateFormatConverter x:Key="DateConv"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="White" Padding="16,12">
            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08"/></Border.Effect>
            <TextBlock Text="Pending Requests" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding PendingLeaves}" Margin="16"
                  Style="{StaticResource ModernDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Requester" Width="200" Binding="{Binding RequesterEmail}"/>
                <DataGridTextColumn Header="Type" Width="120" Binding="{Binding LeaveType, Converter={StaticResource LeaveTypeConv}}"/>
                <DataGridTextColumn Header="From" Width="120" Binding="{Binding DateFrom, Converter={StaticResource DateConv}, ConverterParameter=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="To" Width="120" Binding="{Binding DateTo, Converter={StaticResource DateConv}, ConverterParameter=dd/MM/yyyy}"/>
                <DataGridTextColumn Header="Days" Width="60" Binding="{Binding TotalDays}"/>
                <DataGridTextColumn Header="Reason" Width="*" Binding="{Binding Reason}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
