<Window x:Class="NMKApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NMKApp.Views"
        xmlns:vm="clr-namespace:NMKApp.ViewModels"
        xmlns:converters="clr-namespace:NMKApp.Converters"
        Title="{Binding WindowTitle}" 
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVisConv"/>
        <converters:NullToVisibilityConverter x:Key="NullVisConv"/>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeLineViewModel}">
            <views:TimeLineView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RequestViewModel}">
            <views:RequestView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
            <views:ProjectsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotifyViewModel}">
            <views:NotifyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeaveViewModel}">
            <views:LeaveView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
            <views:ScheduleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="50" Margin="0,4,0,0">
                    <Viewbox Width="30" Height="30">
                        <Canvas Width="100" Height="100">
                            <Polygon Points="50,10 90,35 90,65 50,90 10,65 10,35" Fill="#455A64"/>
                            <Polygon Points="50,10 90,35 50,55 10,35" Fill="#E53935"/>
                            <Polygon Points="10,35 50,55 50,90 10,65" Fill="#CFD8DC"/>
                            <Polygon Points="90,35 50,55 50,90 90,65" Fill="#B0BEC5"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <RadioButton Content="Settings" GroupName="Nav" Tag="&#xE713;" 
                                 Style="{StaticResource SidebarButtonStyle}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <RadioButton Content="Dashboard" GroupName="Nav" Tag="&#xE80F;" 
                                     IsChecked="True" Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>
                        <RadioButton Content="TimeLine" GroupName="Nav" Tag="&#xE787;"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="TimeLine"/>
                        <RadioButton Content="Request" GroupName="Nav" Tag="&#xE715;"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="Request"/>
                        <RadioButton Content="Users" GroupName="Nav" Tag="&#xE77B;"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="Users"/>
                        <RadioButton Content="Projects" GroupName="Nav" Tag="&#xE821;"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="Projects"/>
                        <Grid>
                            <RadioButton Content="Notify" GroupName="Nav" Tag="&#xEA8F;"
                                         Style="{StaticResource SidebarButtonStyle}"
                                         Command="{Binding NavigateToCommand}" CommandParameter="Notify"/>
                            <Border Style="{StaticResource BadgeStyle}" Margin="0,6,8,0"
                                    Visibility="{Binding UnreadNotifyCount, Converter={StaticResource NullVisConv}}">
                                <TextBlock Text="{Binding UnreadNotifyCount}" Foreground="White" 
                                           FontSize="9" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <RadioButton Content="Leave" GroupName="Nav" Tag="&#xE8D1;"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="Leave"/>
                        <RadioButton Content="Schedule" GroupName="Nav" Tag="&#xE787;"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding NavigateToCommand}" CommandParameter="Schedule"/>
                        <RadioButton Content="Refresh" GroupName="Nav" Tag="&#xE72C;"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentViewModel}"/>
            <views:NewTaskView DataContext="{Binding NewTaskVM}" Panel.ZIndex="20"/>
            <Border Background="#40FFFFFF" Panel.ZIndex="100"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolVisConv}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="300" Height="4"/>
                    <TextBlock Text="Loading..." HorizontalAlignment="Center" Margin="0,10,0,0"
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
